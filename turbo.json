{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build", "build"]
    },
    "test:unit": {
      "dependsOn": ["^build", "build"]
    },
    "test:sim:starters": {
      "dependsOn": ["^build", "build"]
    },
    "test:sim:monkey": {
      "dependsOn": ["^build", "build"]
    },
    "test:sim:rest": {
      "dependsOn": ["^build", "build"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
