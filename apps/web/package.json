{
  "name": "@rangers-strike/web",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "prebuild": "cd ../.. && npx turbo run build --filter=@rangers-strike/cards --filter=@rangers-strike/engine",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate:wiki-specs": "tsx scripts/generate-wiki-complete-specs.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@rangers-strike/cards": "*",
    "@rangers-strike/engine": "*",
    "@tanstack/react-virtual": "^3.14.2",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
