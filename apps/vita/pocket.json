{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.rangers-strike.vita",
  "name": "rangers-strike-vita",
  "title": "Rangers Strike",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": ["text.glyphs.baked", "input.buttons"],
      "enhances": ["input.touch"]
    }
  },
  "app": {
    "entry": "src/main.tsx",
    "output": "rangers-strike-main",
    "framework": "solid",
    "viewport": {
      "fixed": { "logical": [480, 272], "presentation": "integer-fit" }
    }
  }
}
