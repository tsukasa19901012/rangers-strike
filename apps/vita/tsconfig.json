{
  // Read by `pocket check|compile|build` (PocketJS type-checks the reachable
  // app modules with this file). The framework lives in the isolated
  // toolchain install (apps/vita/toolchain), not in the npm workspace.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "types": [],
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@rangers-strike/client-core": ["../../packages/client-core/src/index.ts"],
      "solid-js": ["./toolchain/node_modules/solid-js"],
      "solid-js/*": ["./toolchain/node_modules/solid-js/*"],
      "@pocketjs/framework": ["./toolchain/node_modules/@pocketjs/framework/framework/src/index.ts"],
      "@pocketjs/framework/solid": ["./toolchain/node_modules/@pocketjs/framework/framework/src/index.ts"],
      "@pocketjs/framework/solid/components": ["./toolchain/node_modules/@pocketjs/framework/framework/src/components.ts"],
      "@pocketjs/framework/components": ["./toolchain/node_modules/@pocketjs/framework/framework/src/components.ts"],
      "@pocketjs/framework/lifecycle": ["./toolchain/node_modules/@pocketjs/framework/framework/src/lifecycle.ts"],
      "@pocketjs/framework/solid/lifecycle": ["./toolchain/node_modules/@pocketjs/framework/framework/src/lifecycle.ts"],
      "@pocketjs/framework/input": ["./toolchain/node_modules/@pocketjs/framework/framework/src/input-api.ts"],
      "@pocketjs/framework/platform": ["./toolchain/node_modules/@pocketjs/framework/framework/src/platform.ts"],
      "@pocketjs/framework/pak": ["./toolchain/node_modules/@pocketjs/framework/framework/src/pak.ts"]
    }
  },
  "include": ["src"]
}
