{
  "name": "@rangers-strike/cards",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dsl": {
      "types": "./dist/dsl/index.d.ts",
      "import": "./dist/dsl/index.js"
    },
    "./dsl/types": {
      "types": "./dist/dsl/types.d.ts",
      "import": "./dist/dsl/types.js"
    },
    "./dsl/loader": {
      "types": "./dist/dsl/loader.d.ts",
      "import": "./dist/dsl/loader.js"
    },
    "./dsl/registry": {
      "types": "./dist/dsl/registry.d.ts",
      "import": "./dist/dsl/registry.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline/index.d.ts",
      "import": "./dist/pipeline/index.js"
    },
    "./pipeline/extractEffects": {
      "types": "./dist/pipeline/extractEffects.d.ts",
      "import": "./dist/pipeline/extractEffects.js"
    },
    "./pipeline/hashGrantKeywords": {
      "types": "./dist/pipeline/hashGrantKeywords.d.ts",
      "import": "./dist/pipeline/hashGrantKeywords.js"
    },
    "./pipeline/implementedGrantKeywords": {
      "types": "./dist/pipeline/implementedGrantKeywords.d.ts",
      "import": "./dist/pipeline/implementedGrantKeywords.js"
    },
    "./catalog/parity": {
      "types": "./dist/catalog/parity.d.ts",
      "import": "./dist/catalog/parity.js"
    },
    "./schema/*": "./schema/*"
  },
  "scripts": {
    "build": "node scripts/bundle-dsl-overlays.mjs && tsc -p tsconfig.json && cp src/pipeline/effect-name-registry.json dist/pipeline/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate-card-tests": "node scripts/generate-card-tests.mjs",
    "generate-legend1-starter-dsl": "node scripts/generate-legend1-starter-dsl.mjs",
    "generate-all-dsl": "tsx scripts/generate-all-dsl.ts",
    "classify-all-cards": "node scripts/classify-all-cards.mjs",
    "pipeline:card": "node scripts/run-card-pipeline.mjs",
    "pipeline:batch": "tsx scripts/batch-wiki-pipeline.ts",
    "generate-wiki-stubs": "tsx scripts/generate-wiki-catalog-stubs.ts",
    "generate-wiki-set-labels": "tsx scripts/generate-wiki-set-labels.ts",
    "generate-dsl-ready-ids": "tsx scripts/generate-dsl-ready-ids.ts",
    "emit-catalog-shards": "tsx scripts/generate-wiki-catalog-stubs.ts",
    "pipeline:compile-stubs": "tsx scripts/batch-compile-stubs.ts",
    "pipeline:compile-stubs-extended": "tsx scripts/batch-compile-stubs.ts -- --grades C,D,E --merge-report",
    "audit:runtime-delegates": "tsx scripts/audit-runtime-delegates.ts",
    "audit:runtime-effects": "tsx scripts/audit-runtime-effects.ts",
    "emit-core-catalog": "tsx scripts/emit-core-catalog.ts",
    "emit-core-dsl-stubs": "tsx scripts/emit-core-dsl-stubs.ts",
    "emit-vanilla-catalog": "tsx scripts/emit-vanilla-catalog.ts",
    "emit-complexity-catalog": "tsx scripts/emit-complexity-catalog.ts",
    "emit-full-playable-catalog": "tsx scripts/emit-full-playable-catalog.ts",
    "download-xgather-images": "node scripts/download-xgather-images.mjs",
    "download-promo-images": "node scripts/download-promo-images.mjs",
    "normalize-vanilla-dsl": "tsx scripts/normalize-vanilla-dsl.ts",
    "normalize-complexity-dsl": "tsx scripts/normalize-complexity-dsl.ts",
    "pipeline:recompile-vanilla": "tsx scripts/batch-compile-stubs.ts -- --grades A,B,E --merge-report && tsx scripts/normalize-vanilla-dsl.ts",
    "pipeline:recompile-complexity": "tsx scripts/batch-compile-stubs.ts -- --grades C,D --merge-report && tsx scripts/normalize-complexity-dsl.ts",
    "generate-vanilla-smoke": "tsx scripts/generate-vanilla-smoke.ts",
    "generate-full-playable-smoke": "tsx scripts/generate-full-playable-smoke.ts",
    "generate-engine-smoke": "tsx scripts/generate-engine-smoke.ts",
    "audit:fallback-progress": "tsx scripts/audit-fallback-progress.ts",
    "audit:stub-delegates": "tsx scripts/audit-stub-delegates.ts",
    "audit:enqueue-coverage": "tsx scripts/audit-enqueue-coverage.ts",
    "remigrate-enqueue-effects": "tsx scripts/remigrate-enqueue-effects.ts",
    "remigrate-stub-effects": "tsx scripts/remigrate-stub-effects.ts",
    "repair-dsl-hash-keywords": "tsx scripts/repair-dsl-hash-keywords.ts",
    "repair-named-effect-ids": "tsx scripts/repair-named-effect-ids.ts",
    "build-effect-name-registry": "tsx scripts/build-effect-name-registry.ts",
    "audit-hash-grant-keywords": "tsx scripts/audit-hash-grant-keywords.ts",
    "promote-dsl-ready": "tsx scripts/promote-dsl-ready.ts",
    "finalize-effect-primitives": "tsx scripts/finalize-effect-primitives.ts",
    "audit:effect-keywords": "tsx scripts/audit-effect-keywords.ts",
    "pipeline:m18-sync": "tsx scripts/pipeline-m18-sync.ts",
    "pipeline:m19-sync": "tsx scripts/pipeline-m19-sync.ts",
    "pipeline:m20-sync": "tsx scripts/pipeline-m20-sync.ts",
    "pipeline:rollout-sync": "tsx scripts/pipeline-rollout-sync.ts",
    "audit:catalog-parity": "tsx scripts/audit-catalog-parity.ts",
    "audit:rollout-status": "tsx scripts/audit-rollout-status.ts",
    "audit:implementation-gaps": "tsx scripts/audit-implementation-gaps.ts",
    "audit:rs-release": "tsx scripts/audit-rs-release-readiness.ts",
    "enrich-rs-operation-dsl": "tsx scripts/enrich-rs-operation-dsl.ts",
    "metrics:full-playable": "tsx scripts/generate-full-playable-metrics.ts",
    "verify-wiki-effects": "tsx scripts/verify-wiki-effects.ts",
    "wiki-drift": "tsx scripts/wiki-drift.ts",
    "generate-integration-tests": "tsx scripts/generate-integration-tests.ts",
    "pipeline:all": "tsx scripts/pipeline-all.ts",
    "extract-effect-catalog": "tsx scripts/extract-effect-catalog.ts",
    "extract-trigger-catalog": "tsx scripts/extract-trigger-catalog.ts",
    "extract-ruling-cards": "tsx scripts/extract-ruling-cards.ts",
    "extract-implementation-feasibility": "tsx scripts/extract-implementation-feasibility.ts",
    "validate-cards": "node scripts/validate-cards.mjs",
    "download-images": "node scripts/download-images.mjs",
    "download-promoted-images": "node scripts/download-promoted-images.mjs"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
