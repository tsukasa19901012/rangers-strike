{
  "name": "@rangers-strike/engine",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:sim",
    "test:unit": "vitest run --exclude 'src/verticalSlice/**' --exclude src/monkey.test.ts --exclude src/rkBkMonkey.test.ts",
    "test:sim": "vitest run src/verticalSlice src/monkey.test.ts src/rkBkMonkey.test.ts --no-file-parallelism",
    "test:sim:starters": "vitest run src/verticalSlice/simulateAllStarters.test.ts",
    "test:sim:monkey": "vitest run src/monkey.test.ts src/rkBkMonkey.test.ts --no-file-parallelism",
    "test:sim:rest": "vitest run src/verticalSlice --exclude src/verticalSlice/simulateAllStarters.test.ts --no-file-parallelism",
    "test:monkey": "vitest run src/monkey.test.ts"
  },
  "dependencies": {
    "@rangers-strike/cards": "*"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
